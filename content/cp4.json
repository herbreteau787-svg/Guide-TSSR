    {
      "id": "cp4-osi",
      "t": "Modèle OSI",
      "level": "intermediaire",
      "cli": true,
      "r": "Le modèle OSI organise la communication en 7 couches.",
      "tags": [
        "cp4",
        "osi"
      ],
      "g": [],
      "c": "Voir section Commandes utiles.",
      "p": [
        "Erreur de configuration",
